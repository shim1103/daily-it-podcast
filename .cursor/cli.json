{
  "permissions": {
    "allow": [
      "Shell(*)",
      "Read(*)",
      "Write(*)",
      "WebFetch(*)",
      "Mcp(*:*)"
    ],
    "deny": [
      "WebSearch(*)",
      "WebSearch",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Shell(env)",
      "Shell(env *)",
      "Shell(printenv)",
      "Shell(printenv *)",
      "Shell(*printenv*)"
    ]
  }
}
