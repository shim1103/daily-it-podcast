#!/usr/bin/env bash
# scope: Narrow Integration
# 実物: scripts/test-unit.sh / scripts/test-integration.sh
# double: なし
# @require リポジトリ root から実行する。Go と Node/npm が PATH にある。
# @ensure test-unit と test-integration が exit 0 で終わる。
# @invariant 本番 credential を読まない。外部 network に依存しない。
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

"$root/scripts/test-unit.sh"
"$root/scripts/test-integration.sh"
