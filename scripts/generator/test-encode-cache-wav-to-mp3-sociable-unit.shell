#!/usr/bin/env bash
# name: test-encode-cache-wav-to-mp3-sociable-unit
# description: encode-cache-wav-to-mp3 入口と hack EncodeCacheDir を確認する。
# @require リポジトリ内から呼ぶ。bash 3.2+。Go / ffmpeg が PATH にある。
# @ensure hack unit が緑。script が CACHE_ROOT 配下 wav を非空 mp3 にする。不正引数は非0。
# @invariant 実 Drive / secret を使わない。
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
script="${root}/scripts/generator/encode-cache-wav-to-mp3.sh"

# --- case: hack EncodeCacheDir unit ---
# Given: hack/encode-cache-wav-to-mp3 package
# When: go test を実行する
# Then: exit 0
(
  cd "$root/apps/generator"
  go test ./hack/encode-cache-wav-to-mp3/ -count=1
)

if [ ! -x "$script" ]; then
  echo "FAIL: ${script} が実行可能でない" >&2
  exit 1
fi

workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

# --- case: target=test で Encoder 経由変換 ---
# Given: CACHE_ROOT/test に非空 wav
cache_test="${workdir}/test"
mkdir -p "$cache_test"
wav="${cache_test}/ep-1.wav"
ffmpeg -hide_banner -loglevel error -f lavfi -i "sine=f=440:d=0.05" -y "$wav"

# When: encode-cache-wav-to-mp3.sh に test を渡す
CACHE_ROOT="$workdir" bash "$script" test

# Then: 同 stem の非空 mp3 があり、wav は残る
mp3="${cache_test}/ep-1.mp3"
if [ ! -s "$mp3" ]; then
  echo "FAIL: 非空 mp3 が無い: ${mp3}" >&2
  exit 1
fi
if [ ! -f "$wav" ]; then
  echo "FAIL: 入力 wav が消えている" >&2
  exit 1
fi

# --- case: 不正引数 ---
# Given: 引数 staging
# When: encode-cache-wav-to-mp3.sh に staging を渡す
set +e
CACHE_ROOT="$workdir" bash "$script" staging
status=$?
set -e
# Then: 非0
if [ "$status" -eq 0 ]; then
  echo "FAIL: 不正引数で exit 0" >&2
  exit 1
fi

# --- case: target=prod ---
# Given: CACHE_ROOT/prod に非空 wav
cache_prod="${workdir}/prod"
mkdir -p "$cache_prod"
ffmpeg -hide_banner -loglevel error -f lavfi -i "sine=f=880:d=0.05" -y "${cache_prod}/ep-2.wav"

# When: encode-cache-wav-to-mp3.sh に prod を渡す
CACHE_ROOT="$workdir" bash "$script" prod

# Then: prod 配下に非空 ep-2.mp3
if [ ! -s "${cache_prod}/ep-2.mp3" ]; then
  echo "FAIL: prod の非空 mp3 が無い" >&2
  exit 1
fi

echo "PASS: encode-cache-wav-to-mp3 sociable unit"
