#!/usr/bin/env bash
# name: test-drive-purge-wav-verify-set-sociable-unit
# description: drive-purge-wav-verify-set 入口と hack purge の契約を確認する。
# @require リポジトリ内から呼ぶ。bash 3.2+。Go が PATH にある。
# @ensure hack unit が緑。不正引数は非0。Drive env 欠落は非0。
# @invariant 実 Drive へ出ない。credential を設定しない。
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
script="${root}/scripts/generator/drive-purge-wav-verify-set.sh"

# --- case: hack drive-wav-purge unit ---
# Given: hack/drive-wav-purge package
# When: go test を実行する
# Then: exit 0
(
  cd "$root/apps/generator"
  go test ./hack/drive-wav-purge/ -count=1
)

if [ ! -x "$script" ]; then
  echo "FAIL: ${script} が実行可能でない" >&2
  exit 1
fi

# --- case: 不正引数 ---
# Given: 引数 staging
# When: drive-purge-wav-verify-set.sh に staging を渡す
set +e
bash "$script" staging
status1=$?
set -e
# Then: 非0
if [ "$status1" -eq 0 ]; then
  echo "FAIL: 不正引数で exit 0" >&2
  exit 1
fi

# --- case: Drive env 欠落 ---
# Given: GOOGLE_OAUTH_* / DRIVE_FOLDER_ID を unset
# When: drive-purge-wav-verify-set.sh に test を渡す
set +e
env -u GOOGLE_OAUTH_CLIENT_ID -u GOOGLE_OAUTH_CLIENT_SECRET \
  -u GOOGLE_OAUTH_REFRESH_TOKEN -u DRIVE_FOLDER_ID \
  bash "$script" test
status2=$?
set -e
# Then: 非0
if [ "$status2" -eq 0 ]; then
  echo "FAIL: Drive env 欠落なのに exit 0" >&2
  exit 1
fi

echo "PASS: drive-purge-wav-verify-set sociable unit"
