{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "playback-smoke-r2-peer",
  "main": "remote-test-r2-worker.js",
  "compatibility_date": "2026-08-25",
  "r2_buckets": [
    {
      "binding": "EPISODES",
      "bucket_name": "daily-it-podcast-dev"
    }
  ],
  "d1_databases": [
    {
      "binding": "EPISODE_PROGRESS",
      "database_name": "daily-it-podcast-progress-dev",
      "database_id": "51ddafa0-f337-4097-b3bb-3172d5588373"
    }
  ]
}
