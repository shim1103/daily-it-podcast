{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daily-it-podcast",
  "main": "worker/src/worker-entry.ts",
  "compatibility_date": "2026-08-25",
  "keep_vars": true,
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/episodes", "/episodes/*"]
  },
  "observability": {
    "enabled": true
  },
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "EPISODES",
      "bucket_name": "daily-it-podcast-prod"
    }
  ]
}
