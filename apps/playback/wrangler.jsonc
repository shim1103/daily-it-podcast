{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daily-it-podcast",
  "main": "worker/src/worker-entry.ts",
  "compatibility_date": "2026-08-25",
  // why: UI と `/episodes*` を同一 origin で配信する。Assets は Vite build 出力。
  //   `/episodes*` だけ Worker を先に走らせ、それ以外は静的 file を返す（hash UI のため厚い SPA fallback は不要）。
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/episodes", "/episodes/*"]
  }
}
