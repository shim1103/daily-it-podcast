{
  "name": "playback",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "test:unit": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "lint:layers": "depcruise --config .dependency-cruiser.mjs --ts-pre-compilation-deps \"worker/src/**/*.ts\" \"web/src/**/*.ts\" \"web/src/**/*.tsx\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^16.10.4",
    "happy-dom": "^20.11.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "ajv": "^8.17.1",
    "hono": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  }
}
