```mermaid

graph TD
    subgraph ORCH["Orchestrator (packages/orchestrator)"]
        CFG["config/podcast.config.ts<br/>尺 / 話者モード / 情報源 / API provider<br/>Drive保存先 / cron有効無効"]
    end

    subgraph FETCH["情報取得システム (packages/info-fetcher)"]
        F1["ManualTextFetcher (有効)"]
        F2["TwitterFetcher (無効/モック)"]
        F3["MastodonFetcher (無効/モック)"]
        F4["NewsFeedFetcher (無効/モック)"]
    end

    subgraph SCRIPT["テーマ原稿生成システム (packages/script-generator)"]
        SG["ScriptGenerator<br/>ThemeInfo → ThemeScript"]
    end

    subgraph MANU["原稿生成システム (packages/manuscript-builder)"]
        MB["ManuscriptBuilder<br/>ThemeScript[] → Manuscript (原稿.json)"]
    end

    subgraph TTS["TTSシステム (packages/tts)"]
        TS["TtsService<br/>Manuscript → Buffer (音声)"]
    end

    subgraph DRIVE["Drive保存システム (packages/drive)"]
        DS["DriveService<br/>save / listEpisodes / getEpisode"]
    end

    subgraph UI["再生UI (apps/web / Next.js)"]
        PG1["エピソード一覧画面<br/>(Drive走査)"]
        PG2["エピソード再生画面<br/>音声プレーヤー + 原稿表示"]
        POP["意味検索ポップアップ<br/>(テキストタップ)"]
    end

    subgraph CORE["共通型・Interface (packages/core)"]
        IF["ThemeInfo / ThemeScript<br/>Manuscript / InfoFetcher<br/>ScriptGenerator / TtsService<br/>DriveService / PodcastError"]
    end

